# Copy to .env.local and fill in. Never commit .env.local.
#
# Local dev subdomains: sales.localhost:3000 and admin.localhost:3000 resolve
# without hosts-file changes in Chrome and Firefox.

# --- Database (Postgres — Neon or Supabase, both work)
# Must be a POOLED connection string. The app uses the `pg` TCP driver because
# token mutations require real transactions with SELECT ... FOR UPDATE, which an
# HTTP driver cannot hold across statements.
# Supabase: use the pooler host on port 6543, not the direct 5432 host.
DATABASE_URL=

# --- Redis (Upstash via Vercel Marketplace: `vercel integration add upstash`)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Session
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- WhatsApp OTP gateway
# Optional, and blank counts as unset — leaving these three empty is a valid
# configuration, not a half-finished one. Below production a missing gateway
# shows the OTP in the dev UI instead of sending it. Set them and they are
# validated: a malformed URL fails at the first serverEnv() call.
# Self-hosted gateway; POST multipart with appkey/authkey/to/message.
# URL defaults to https://nagariku.fun/api/create-message when unset.
WHATSAPP_API_URL=
WHATSAPP_APP_KEY=
WHATSAPP_AUTH_KEY=

# --- Prototype login (DANGEROUS — leave unset unless you mean it)
# Set to 1 to show the OTP on the login screen instead of sending it, in
# production too. That is not a weaker login, it is no login: anyone who knows a
# user's number can read the code off the page and sign in as them, admin
# included. Only for a demo deployment holding no real data. Delete it the moment
# the WhatsApp keys above are filled in. Below production it is unnecessary —
# missing gateway keys already show the code in development.
# DEMO_OTP_ON_SCREEN=1

# --- Vercel Cron
# Required. The cron route settles auctions and awards leads, so without a secret
# it is a URL anyone can fire. Vercel sends it as `Authorization: Bearer <value>`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Payment gateway (provider not yet chosen; see TODO.md § Payment)
# PAYMENT_SERVER_KEY=
# PAYMENT_WEBHOOK_SECRET=
