# --- WhatsApp OTP gateway
# Names must match lib/whatsapp/client.ts exactly. The gateway needs BOTH keys:
# the multipart body sends `appkey` and `authkey` on every request.
# URL is optional; it falls back to https://nagariku.fun/api/create-message.
# Empty keys are fine in development (sendOtp returns the code instead of
# sending it), but in production they make every login fail with `not_configured`.
WHATSAPP_API_URL=
WHATSAPP_APP_KEY=
WHATSAPP_AUTH_KEY=

